# Copy this file to .env and fill in what you use. Lines starting with # are ignored.

# --- Model -------------------------------------------------------------------
# Claude API (production quality). Keys come from console.anthropic.com and are
# billed separately from a Claude subscription, with prepaid credit.
ANTHROPIC_API_KEY=sk-ant-...
BRAIN_MODEL=claude-opus-5-5
# Thinking depth on Claude models: low | medium | high | xhigh | max
BRAIN_EFFORT=medium

# Local and free instead: Ollama's Anthropic-compatible API. Comment out the
# API key above and set these two (any model with tool support works):
# ANTHROPIC_BASE_URL=http://localhost:11434
# BRAIN_MODEL=qwen3.6:35b-a3b

# --- Data --------------------------------------------------------------------
# Where the agency knowledge (services, prices, tone), the client memory and
# the reports live. Defaults to ./data/{knowledge,clients,reports}. Point them
# at an Obsidian vault to read and write the notes from there.
# BRAIN_KNOWLEDGE_DIR=C:\path\to\vault\Brain\Knowledge
# BRAIN_CLIENTS_DIR=C:\path\to\vault\Brain\Clients
# BRAIN_REPORTS_DIR=C:\path\to\vault\Brain\Reports
# BRAIN_PROPOSALS_DIR=C:\path\to\vault\Brain\Proposals
# Traces of every run (JSON), for debugging and evals. Default: ./runs
# BRAIN_RUNS_DIR=runs

# --- Limits per run ----------------------------------------------------------
# BRAIN_MAX_STEPS=20
# BRAIN_MAX_FETCHES=8
# BRAIN_MAX_TOOL_RESULT_CHARS=12000
# BRAIN_TIMEOUT_MS=600000
